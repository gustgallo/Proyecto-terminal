<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # La API PHP tiene su propio router y nunca debe caer en el fallback de React.
  RewriteRule ^api(?:/|$) - [L]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
